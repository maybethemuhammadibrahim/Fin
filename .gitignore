# ---- Secrets. Never commit these. ----
.env
.streamlit/secrets.toml

# ---- Data: sourced corpora, built scenarios, uploads, LLM cache ----
# Keep the directory skeleton, ignore everything in it.
data/**
!data/**/
!data/**/.gitkeep
# The sealed test-set manifest is tracked on purpose, for the same reason
# eval_set.jsonl is (below): it is the PROOF that training never saw the test
# contracts, and a proof that vanishes on the next machine proves nothing.
# data/ has already been lost twice (#33, #44). The contracts themselves stay
# ignored -- they are bulk and reproducible from the seed; the manifest is not.
!data/corpus/heldout/SEALED.json

# ---- Local databases ----
*.db
*.sqlite
*.sqlite3

# ---- Training data is generated; the held-out eval set is NOT. ----
training/data/*.jsonl
!training/data/eval_set.jsonl

# ---- Python ----
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/
