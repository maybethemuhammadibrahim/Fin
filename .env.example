# FinSight — copy to .env and fill in.  [B]
# .env is gitignored. On Streamlit Community Cloud these same keys go into
# Streamlit Secrets instead (Settings -> Secrets), in TOML form.

# ---- Database ----
# Supabase -> Project Settings -> Database -> Connection string (URI).
# Leave DATABASE_URL blank to fall back to sqlite:///data/finsight.db for offline work.
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres
SUPABASE_URL=https://[REF].supabase.co

# Project Settings -> API. The "anon public" key. Safe to publish.
SUPABASE_KEY=

# Project Settings -> API -> the "service_role" key. SERVER ONLY.
# It bypasses row-level security, so Storage can write to a fully private
# bucket with no policies. Streamlit renders server-side, so this never reaches
# a browser — that is what makes using it here safe. Never commit it, never log
# it, and put it in Streamlit Secrets (not the repo) when deploying.
SUPABASE_SERVICE_KEY=

# ---- LLM — our own self-hosted model (ADR-011). No frontier API calls. ----
# ADR-002 still holds: one variable swaps the endpoint. The values are now our
# own Colab/Kaggle notebook sessions instead of vendor APIs.
#
# The tunnel URL CHANGES EVERY TIME the notebook restarts. Expect to edit this
# daily, and to edit it in Streamlit Secrets on the morning of a demo.
#
# NOTE: never put a "# comment" on the same line as an EMPTY value. python-dotenv
# strips inline comments only when a value is present; on a blank variable the
# comment text becomes the value. Keep the comments on their own lines, above.

# colab_tunnel | kaggle_tunnel | custom
LLM_PROVIDER=colab_tunnel

# https://<something>.trycloudflare.com  (primary session)
COLAB_TUNNEL_URL=

# the backup session
KAGGLE_TUNNEL_URL=

# any other OpenAI-compatible endpoint
CUSTOM_BASE_URL=

# Shared secret the notebook checks on every request. A quick tunnel is a PUBLIC
# URL — without this, anyone who finds it gets free inference on your GPU quota.
LLM_API_KEY=

# Base weights from Phase 5; becomes finsight-qwen2.5-3b once Phase 10's
# adapter is serving. That one value is the whole base-vs-tuned comparison.
LLM_MODEL=Qwen/Qwen2.5-3B-Instruct

# a cold start loads 3B of weights before the first answer
LLM_TIMEOUT_SECONDS=120

# ---- Data sourcing ----
HF_TOKEN=

# ---- Behaviour ----
# also what keeps a demo alive if the tunnel dies
LLM_CACHE_ENABLED=true
LOG_LEVEL=INFO
